      "parameters": {
        "jsCode": "const markdownText = $input.first().json.query.taskContent; // Вхідний текст Markdown\nconst lines = markdownText.split('\\n');\nlet blocks = []; // Масив для всіх блоків\n\nlines.forEach(line => {\n  if (line.startsWith('###')) {\n    blocks.push({\n      \"type\": \"heading_1\",\n      \"heading_1\": {\n        \"rich_text\": [{\n          \"text\": {\n            \"content\": line.replace('###', '').trim()\n          }\n        }]\n      }\n    });\n  } else if (line.startsWith('- [ ]')) {\n    blocks.push({\n      \"type\": \"to_do\",\n      \"to_do\": {\n        \"rich_text\": [{\n          \"text\": {\n            \"content\": line.replace('- [ ]', '').trim()\n          }\n        }],\n        \"checked\": false\n      }\n    });\n  } else if (line.startsWith('-')) {\n    blocks.push({\n      \"type\": \"bulleted_list_item\",\n      \"bulleted_list_item\": {\n        \"rich_text\": [{\n          \"text\": {\n            \"content\": line.replace('-', '').trim()\n          }\n        }]\n      }\n    });\n  }\n});\n\n// Повертаємо масив блоків як одну змінну\nreturn { blocks };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "****",
      "name": "Convert Markdown to JSON"
