    {
      "parameters": {
        "jsCode": "const httpOutput = $input.first().json;\nconst webhookData = $('Get Slack Message').first().json;\nconst allMessages = httpOutput.messages;\n\n// Safety check\nif (!Array.isArray(allMessages) || allMessages.length < 2) {\n  throw new Error(\"Not enough messages to extract context.\");\n}\n\n// Step 1: Determine user ID from first message\nconst userId = allMessages[0].user;\n\n// Step 2: Select messages\nlet selectedMessages = [];\n// Always include first interaction\nselectedMessages.push(allMessages[0], allMessages[1]);\n\n// Add last 10 messages, avoiding duplicates\nconst lastMessages = allMessages.slice(-10);\nfor (const msg of lastMessages) {\n  if (!selectedMessages.includes(msg)) {\n    selectedMessages.push(msg);\n  }\n}\n\n// Step 3: Assign roles and clean user messages\nconst openaiMessages = selectedMessages.map(msg => {\n  const isUser = msg.user === userId;\n  const rawText = msg.text || \"\";\n  const cleanedText = isUser\n    // Remove @bot mentions or Slack mentions like <@U12345>\n    ? rawText.replace(/<@[^>]+>|@\\w+/g, \"\").trim()\n    : rawText;\n  return {\n    role: isUser ? 'user' : 'assistant',\n    content: cleanedText\n  };\n});\n\n// Get current user input (clean from mentions) - ADDED\nconst currentInput = (webhookData.event && webhookData.event.text) \n  ? webhookData.event.text.replace(/<@[^>]+>|@\\w+/g, \"\").trim()\n  : \"\";\n\n// Convert OpenAI messages to text format for the OpenAI node - ADDED\nlet conversationText = \"Previous conversation:\\n\";\nopenaiMessages.forEach(msg => {\n  conversationText += `${msg.role}: ${msg.content}\\n`;\n});\nconversationText += `\\nuser: ${currentInput}\\n\\nassistant:`;\n\n// Final output\nreturn [{\n  json: {\n    httpOutput,\n    webhookData,\n    openaiMessages,\n    currentUserInput: currentInput,\n    conversationPrompt: conversationText\n  }\n}];"
      },
      "id": "****",
      "name": "Reformat Data for OpenAI Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3180,
        580
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "****"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI assistant, operating in the role of a seasoned project manager, helping users with task management and business operations.\n\nYour job is to handle two kinds of inputs:\n\n1. Confirmation or cancellation commands (one‐word or short phrases), such as:\nCreate command:\nInputs like \"yes\", \"confirm\", \"create task\" indicate confirmation.\n→ Return the following array:\nTask Created Successfully!, <The populated task template>\n\nCancel command:\nInputs like \"no\", \"cancel task\", \"delete\", \"remove\", \"drop task\" indicate cancellation.\n→ Return the following array:\nCreation of Task is Cancelled!, \"\"\n\n2. Task modification or feedback:\nIf the user's message is not a short confirm/cancel phrase, treat it as feedback or a modification request for the provided populated task template.\n\nUse the full conversation context to update the task while preserving the original structure:\n\nDescription\n\nSteps\n\nSuccess Criteria\n\nAccess + Dependencies\n\nRisks + How to Mitigate\n\nOutput the modified task with:\nHere is the modified task:, <Modified task template>\n\nSpecial Handling for Double Confirmation:\nIf the user confirms again after a similarity warning, such as saying \"yes, create it anyway,\" proceed without checking again and return:\nTask Created Successfully, <The populated task template>\n\nSpecial Handling for Duplicated creations:\nIf the user has already asked for the task to be created, and the task has been created and the user has received confirmation of task creation, make sure to repeat the message of the task creation to the user\n\nContext Handling:\nPrevious conversation context: {{ $json.conversationPrompt }}\nCurrent user input: (the last message given by the role 'user')\n\n\nNote: The <The populated task template> or <Modified task template> must be fully structured based on the original format unless the user explicitly asks for a section to be removed.",
              "role": "assistant"
            }
          ]
        },
        "options": {}
      },
