        "messages": {
          "values": [
            {
              "content": "=You are an intelligent assistant designed to help users create and manage tasks.\n\nHere is the user's request: \"{{ $json.message[0] }}\"\n\nInstruction: \nExtract the most relevant keyword that represent the core of the task. Choose a noun or action phrases that best describe the task's subject or goal.\n\nOutput Format:\nOne keyword\n\nExample: \nUser Input: \"Find me a book to read\"\nKeyword to return: \"book\"",
              "role": "assistant"
            }
          ]
        },
        "options": {}
      },
