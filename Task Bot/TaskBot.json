    {
      "parameters": {
        "jsCode": "let content = $input.first().json.message.content;\n\ncontent = content.replace(/^\\*_(.*?)_\\*$/gm, '### $1').replace(/^• :ballot_box_with_check: (.*$)/gm, '- [ ] $1').replace(/^• :white_check_mark: (.*$)/gim, '- [x] $1').replace(/^• (.*$)/gm, '- $1');\n\nlet task = content.trim();\nconst index = task.indexOf('#');\nif (index !== -1) {\n  task = task.substring(index).trim();\n}\n\nconst lines = task.split('\\n');\nconst title = lines.slice(2, 3).join().replace(\"- \", \"\").trim();\nconst taskBody = lines.slice(4).join('\\n').trim();\n\nreturn [\n  {\n    title,\n    task: taskBody\n  }\n];"
      },
